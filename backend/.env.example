# ─────────────────────────────────────────────────────────
# Supabase (copy these from Supabase dashboard → Settings → Database)
# ─────────────────────────────────────────────────────────
#
# DATABASE_URL  = pooler URL  (used at runtime — put this in Vercel)
#   Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   Example: postgresql://postgres.abcdefghijkl:MyPass@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL    = direct URL  (used only for migrations — put this in Vercel too)
#   Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#   Example: postgresql://postgres:MyPass@db.abcdefghijkl.supabase.co:5432/postgres
#
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

