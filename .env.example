# ─────────────────────────────────────────────────────────────────────────────
# LionMessenger — Vercel Environment Variables
# Copy these keys into your Vercel project dashboard:
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk (Authentication) ────────────────────────────────────────────────────
# From https://dashboard.clerk.com → Your App → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_d29ya2FibGUtc2F3ZmlzaC04MC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_zbbnOk4Fh6OEWkIgQscAf7h3VT7rVjbrqRjlwPHMZq

# Clerk Webhook Secret (create a webhook endpoint in Clerk dashboard first)
# Go to: Clerk Dashboard → Webhooks → Add Endpoint
# Endpoint URL: https://YOUR-VERCEL-URL.vercel.app/api/auth/webhook
# Events to subscribe: user.created, user.updated, user.deleted
# Then copy the "Signing Secret" here:
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── Supabase Database ─────────────────────────────────────────────────────────
# ⚠️  IMPORTANT: The keys you have (sb_publishable_*, sb_secret_*) are Supabase
# API keys, NOT database connection strings. You need the PostgreSQL URLs.
#
# Go to: https://supabase.com/dashboard → Your Project
#        → Settings → Database → Connection string
#
# Copy "Transaction" mode URL for DATABASE_URL (used by Vercel serverless):
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Copy "Direct" connection URL for DIRECT_URL (used for migrations only):
DIRECT_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Stream Chat ───────────────────────────────────────────────────────────────
# From https://getstream.io/dashboard → Your App → Overview
STREAM_API_KEY=g27tvktrtkb5
STREAM_API_SECRET=REPLACE_WITH_YOUR_STREAM_API_SECRET

# ── App Config ────────────────────────────────────────────────────────────────
NODE_ENV=production

# CORS: comma-separated list of allowed origins (your Flutter web app domain)
# Leave as * for now while testing:
ALLOWED_ORIGINS=*
